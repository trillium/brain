+// STORES is one array that is refilled IN PLACE, so every module that imported
+// it (or captured it as a default parameter) sees a store created, renamed or
+// removed elsewhere in the fleet. `brain stores sync` rewrites stores.yaml and
+// ~/.config/brain/registry.applied on every registry change; this re-reads the
+// file when its mtime moves (one statSync per request).
+export const STORES: string[] = []
+
+export function refreshStores(): void {
+  let mtime: number
+  try { mtime = statSync(STORES_FILE).mtimeMs } catch { return } // keep the last good list
+  if (mtime === storesMtimeMs) return
+  const cfg = yaml.load(readFileSync(STORES_FILE, 'utf8')) as StoresConfig
+  if (!cfg || !cfg.stores) return
+  storesConfig = cfg
+  storesMtimeMs = mtime
+  STORES.length = 0
+  STORES.push(...Object.keys(cfg.stores))
+}
+refreshStores()
+
+export const storeAbout = (store: string): string => {
+  refreshStores()
+  return storesConfig.stores[store]?.about ?? ''
+}
+
+// The registry epoch this machine last applied (written by `brain stores sync`);
+// bridge_info reports it so `brain stores doctor --fleet` can compare.
+export const storesEpoch = (): number => {
+  try {
+    const raw = JSON.parse(readFileSync(configFileReadOnly('registry.applied'), 'utf8')) as { epoch?: number }
+    return typeof raw.epoch === 'number' ? raw.epoch : 0
+  } catch { return 0 }
+}
